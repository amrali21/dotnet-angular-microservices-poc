# Copy this file to .env and fill in your SQL Server credentials.
# These are injected into the Docker containers at runtime.

SQL_USER=sa
SQL_PASSWORD=P@ssw0rd

# One connection string per service database (see db/ for the create scripts).
# Same host/credentials, different Initial Catalog.
INVOICE_DB=Data Source=host.docker.internal,1433;Initial Catalog=ledgerly-invoice;Persist Security Info=True;User ID=CHANGE_ME;Password=CHANGE_ME;Encrypt=False;TrustServerCertificate=True
CUSTOMER_DB=Data Source=host.docker.internal,1433;Initial Catalog=ledgerly-customer;Persist Security Info=True;User ID=CHANGE_ME;Password=CHANGE_ME;Encrypt=False;TrustServerCertificate=True
DASHBOARD_DB=Data Source=host.docker.internal,1433;Initial Catalog=ledgerly-dashbaord;Persist Security Info=True;User ID=CHANGE_ME;Password=CHANGE_ME;Encrypt=False;TrustServerCertificate=True
AUTH_DB=Data Source=host.docker.internal,1433;Initial Catalog=ledgerly-auth;Persist Security Info=True;User ID=CHANGE_ME;Password=CHANGE_ME;Encrypt=False;TrustServerCertificate=True

# Shared JWT signing secret used by auth-service (issuer) and by the gateway +
# invoice/cust/dashboard services (validators). Must be identical everywhere.
# Generate a real value with e.g.: openssl rand -base64 64
JWT_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_ISSUER=ledgerly-microservices-auth
JWT_AUDIENCE=ledgerly-microservices-clients
JWT_EXPIRES_MINUTES=60

# RabbitMQ broker credentials, shared by invoice/cust-service (publishers) and
# dashboard-service (consumer). Default guest/guest is fine for local/demo use.
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
